FROM node:24.18.0-trixie-slim@sha256:5301bbf5e8046148348b1dea15436326f43c579031f8d76654a631225bdfe467 AS build
ARG SOURCE_DATE_EPOCH
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm contracts:generate \
  && pnpm --filter @ai-job-apply/database-migrations build \
  && pnpm --filter @ai-job-apply/profile-service... build \
  && pnpm --filter @ai-job-apply/jobs-service build \
  && pnpm --filter @ai-job-apply/documents-service build \
  && pnpm --filter @ai-job-apply/matching-service build \
  && pnpm --filter @ai-job-apply/billing-service build \
  && pnpm --filter @ai-job-apply/database-migrations deploy --prod --legacy /migration/runner \
  && pnpm --filter @ai-job-apply/profile-service deploy --prod --legacy /migration/profile \
  && pnpm --filter @ai-job-apply/jobs-service deploy --prod --legacy /migration/jobs \
  && pnpm --filter @ai-job-apply/documents-service deploy --prod --legacy /migration/documents \
  && pnpm --filter @ai-job-apply/matching-service deploy --prod --legacy /migration/matching \
  && pnpm --filter @ai-job-apply/billing-service deploy --prod --legacy /migration/billing
RUN node --input-type=module -e 'import{access}from"node:fs/promises";import{createRequire}from"node:module";process.chdir("/migration");for(const path of ["runner/dist/src/restore-verifier-cli.js","runner/dist/src/restore-verifier.js","runner/restore-manifest.v1.json","matching/dist/src/migrate.js","billing/dist/src/migrate.js"])await access(path);const{loadCurrentRestoreManifest}=await import("file:///migration/runner/dist/src/restore-verifier.js");const source=loadCurrentRestoreManifest();if(source.manifest.contributors.length!==5||source.manifest.contributors.flatMap(x=>x.relations).length!==39||source.manifest.contributors.flatMap(x=>x.migrations).length!==14)throw new Error("restore manifest package mismatch");createRequire(new URL("file:///migration/profile/package.json")).resolve("postgres");createRequire(new URL("file:///migration/billing/package.json")).resolve("postgres");console.log("restore-verifier-package-smoke:ok")'
RUN SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" node -e 'const fs=require("node:fs"),path=require("node:path");const raw=process.env.SOURCE_DATE_EPOCH;if(!/^[0-9]+$/.test(raw))throw new Error("SOURCE_DATE_EPOCH must be Unix seconds");const epoch=Number(raw),instant=new Date(epoch*1000);if(!Number.isSafeInteger(epoch)||Number.isNaN(instant.valueOf()))throw new Error("invalid SOURCE_DATE_EPOCH");const root="/migration",moduleFiles=[];const normalize=(entry)=>{const stat=fs.lstatSync(entry);if(stat.isDirectory()){for(const child of fs.readdirSync(entry).sort())normalize(path.join(entry,child));}if(stat.isSymbolicLink())fs.lutimesSync(entry,instant,instant);else fs.utimesSync(entry,instant,instant);};const discover=(entry)=>{const stat=fs.lstatSync(entry);if(!stat.isDirectory())return;for(const child of fs.readdirSync(entry).sort()){const candidate=path.join(entry,child);if(child===".modules.yaml")moduleFiles.push(candidate);else if(fs.lstatSync(candidate).isDirectory())discover(candidate);}};discover(root);if(moduleFiles.length!==5)throw new Error(`expected exactly five generated .modules.yaml files, found ${moduleFiles.length}`);for(const file of moduleFiles){const current=fs.readFileSync(file,"utf8"),matches=current.match(/^prunedAt:.*$/gm)||[];if(matches.length!==1)throw new Error(`expected exactly one prunedAt in ${file}`);fs.writeFileSync(file,current.replace(/^prunedAt:.*$/m,`prunedAt: ${instant.toUTCString()}`));}normalize(root);'

FROM gcr.io/distroless/nodejs24-debian13:nonroot-amd64@sha256:b1386d556b478c420927eb212236bfb31be9834a4549850a060a6351f7fff514 AS runtime
ENV NODE_ENV=production
WORKDIR /migration
COPY --from=build --chown=65532:65532 /migration /migration
USER 65532:65532
CMD ["runner/dist/src/main.js"]
