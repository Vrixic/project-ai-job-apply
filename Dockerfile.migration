FROM node:24.18.0-trixie-slim@sha256:5301bbf5e8046148348b1dea15436326f43c579031f8d76654a631225bdfe467 AS build
ARG SOURCE_DATE_EPOCH
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm contracts:generate \
  && pnpm --filter @ai-job-apply/database-migrations build \
  && pnpm --filter @ai-job-apply/profile-service... build \
  && pnpm --filter @ai-job-apply/jobs-service... build \
  && pnpm --filter @ai-job-apply/documents-service build \
  && pnpm --filter @ai-job-apply/matching-service build \
  && pnpm --filter @ai-job-apply/billing-service build \
  && pnpm --filter @ai-job-apply/trust-service build \
  && pnpm --filter @ai-job-apply/applications-service build \
  && pnpm --filter @ai-job-apply/database-migrations deploy --prod --legacy /migration/runner \
  && pnpm --filter @ai-job-apply/profile-service deploy --prod --legacy /migration/profile \
  && pnpm --filter @ai-job-apply/jobs-service deploy --prod --legacy /migration/jobs \
  && pnpm --filter @ai-job-apply/documents-service deploy --prod --legacy /migration/documents \
  && pnpm --filter @ai-job-apply/matching-service deploy --prod --legacy /migration/matching \
  && pnpm --filter @ai-job-apply/billing-service deploy --prod --legacy /migration/billing \
  && pnpm --filter @ai-job-apply/trust-service deploy --prod --legacy /migration/trust \
  && pnpm --filter @ai-job-apply/applications-service deploy --prod --legacy /migration/applications
RUN node --input-type=module -e 'import{access}from"node:fs/promises";import{createRequire}from"node:module";process.chdir("/migration");for(const path of ["runner/dist/src/restore-verifier-cli.js","runner/dist/src/restore-verifier.js","runner/restore-manifest.v1.json","profile/dist/src/run-private-feature-acceptance.js","profile/migrations/0007_candidate_rights_export_null_omission.sql","profile/migrations/0008_ugc_contribution_consents.sql","profile/migrations/0009_ugc_contribution_consent_candidate_rights.sql","profile/migrations/0010_restricted_answer_vault.sql","documents/migrations/0003_candidate_rights.sql","documents/migrations/0004_resume_deletion.sql","documents/migrations/0005_resume_purge.sql","jobs/migrations/0009_provider_ingestion_sources.sql","jobs/migrations/0010_public_job_truth_fields.sql","jobs/migrations/0011_positive_source_withdrawal.sql","jobs/migrations/0012_candidate_rights.sql","jobs/migrations/0013_public_job_sitemap.sql","jobs/migrations/0014_job_contribution_intake.sql","jobs/migrations/0015_source_revalidation_lifecycle.sql","jobs/migrations/0016_job_contribution_candidate_rights.sql","jobs/migrations/0017_job_contribution_processing.sql","jobs/migrations/0018_job_contribution_processing_delivery.sql","jobs/migrations/0019_job_contribution_provider_publication.sql","jobs/migrations/0020_contribution_trust_reprocessing.sql","jobs/migrations/0021_development_contribution_operation_lease.sql","jobs/migrations/0022_development_contribution_provider_leases.sql","jobs/migrations/0023_contribution_verification_refresh.sql","jobs/migrations/0024_contribution_appeal_restoration.sql","matching/dist/src/migrate.js","matching/dist/src/run-private-feature-acceptance.js","matching/migrations/0002_candidate_rights.sql","matching/migrations/0003_private_saved_page_captures.sql","billing/dist/src/migrate.js","billing/migrations/0002_candidate_rights.sql","trust/dist/src/migrate.js","trust/migrations/0001_ugc_trust_foundation.sql","trust/migrations/0002_candidate_rights.sql","trust/migrations/0003_decision_signals.sql","trust/migrations/0004_accepted_independent_evidence.sql","trust/migrations/0005_development_test_removal.sql","applications/dist/src/migrate.js","applications/migrations/0001_applications_foundation.sql","applications/migrations/0002_candidate_rights.sql","applications/migrations/0003_manual_submission.sql","applications/migrations/0004_packet_preparation.sql","applications/migrations/0005_preparation_dispatch.sql","documents/migrations/0006_cover_letters.sql","documents/migrations/0007_cover_letter_work_authorizations.sql","profile/migrations/0011_active_candidate_lease.sql"])await access(path);const{loadCurrentRestoreManifest}=await import("file:///migration/runner/dist/src/restore-verifier.js");const source=loadCurrentRestoreManifest();if(source.manifest.manifestId!=="d3-application-lifecycle-profile-jobs-documents-matching-billing-trust-applications-v1"||source.manifest.contributors.length!==7||source.manifest.contributors.flatMap(x=>x.schemas).length!==11||source.manifest.contributors.flatMap(x=>x.relations).length!==83||source.manifest.contributors.flatMap(x=>x.migrations).length!==57)throw new Error("restore manifest package mismatch");for(const owner of ["profile","billing","trust"])createRequire(new URL(`file:///migration/${owner}/package.json`)).resolve("postgres");console.log("restore-verifier-package-smoke:ok")'
RUN SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" node -e 'const fs=require("node:fs"),path=require("node:path");const raw=process.env.SOURCE_DATE_EPOCH;if(!/^[0-9]+$/.test(raw))throw new Error("SOURCE_DATE_EPOCH must be Unix seconds");const epoch=Number(raw),instant=new Date(epoch*1000);if(!Number.isSafeInteger(epoch)||Number.isNaN(instant.valueOf()))throw new Error("invalid SOURCE_DATE_EPOCH");const root="/migration",moduleFiles=[];const normalize=(entry)=>{const stat=fs.lstatSync(entry);if(stat.isDirectory()){for(const child of fs.readdirSync(entry).sort())normalize(path.join(entry,child));}if(stat.isSymbolicLink())fs.lutimesSync(entry,instant,instant);else fs.utimesSync(entry,instant,instant);};const discover=(entry)=>{const stat=fs.lstatSync(entry);if(!stat.isDirectory())return;for(const child of fs.readdirSync(entry).sort()){const candidate=path.join(entry,child);if(child===".modules.yaml")moduleFiles.push(candidate);else if(fs.lstatSync(candidate).isDirectory())discover(candidate);}};discover(root);if(moduleFiles.length!==7)throw new Error(`expected exactly seven generated .modules.yaml files, found ${moduleFiles.length}`);for(const file of moduleFiles){const current=fs.readFileSync(file,"utf8"),matches=current.match(/^prunedAt:.*$/gm)||[];if(matches.length!==1)throw new Error(`expected exactly one prunedAt in ${file}`);fs.writeFileSync(file,current.replace(/^prunedAt:.*$/m,`prunedAt: ${instant.toUTCString()}`));}normalize(root);'

FROM node:24.18.0-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436 AS runtime
RUN wget -q -O /tmp/libcrypto3.apk https://dl-cdn.alpinelinux.org/alpine/v3.23/main/x86_64/libcrypto3-3.5.8-r0.apk \
  && echo "a5592b5cf276bc7a30ac7b161d46446085490b640faa1f839ea98eb15aacad31  /tmp/libcrypto3.apk" | sha256sum -c - \
  && wget -q -O /tmp/libssl3.apk https://dl-cdn.alpinelinux.org/alpine/v3.23/main/x86_64/libssl3-3.5.8-r0.apk \
  && echo "f80b76cb5e5a52cfc1ced08f8dc3022adc0ce0a3d6e7741976731b22c71fe310  /tmp/libssl3.apk" | sha256sum -c - \
  && apk add --no-network /tmp/libcrypto3.apk /tmp/libssl3.apk ca-certificates-bundle zlib \
  && apk info -e "libcrypto3=3.5.8-r0" \
  && apk info -e "libssl3=3.5.8-r0" \
  && apk del apk-tools \
  && rm -f /tmp/libcrypto3.apk /tmp/libssl3.apk \
  && rm -rf /usr/local/lib/node_modules /opt/yarn-v1.22.22 \
  && rm -f /usr/local/bin/corepack /usr/local/bin/docker-entrypoint.sh /usr/local/bin/nodejs \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    /var/log/apk.log \
  && test ! -e /sbin/apk \
  && test -f /lib/apk/db/installed \
  && test -f /etc/ssl/certs/ca-certificates.crt
ENV NODE_ENV=production
WORKDIR /migration
COPY --from=build --chown=65532:65532 /migration /migration
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/node"]
CMD ["runner/dist/src/main.js"]
