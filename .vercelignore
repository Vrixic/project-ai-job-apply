# Upload only the monorepo source required to build the two Next.js projects. Local credentials,
# dependencies, build output, Terraform caches/state, evidence, and unrelated workstation files
# must never enter a Vercel source deployment.
/*

!.vercelignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!turbo.json
!patches
patches/*
!patches/image-size@1.2.1.patch
!patches/node-forge@1.4.0.patch
!patches/braces@3.0.3.patch
!frontend
!frontend/**
!packages
packages/*
!packages/api-contracts
!packages/api-contracts/**
!packages/ats-sdk
!packages/ats-sdk/**
!packages/config
!packages/config/**

frontend/extension
frontend/extension/**
frontend/mobile
frontend/mobile/**

**/.env*
**/.next
**/.next/**
**/.turbo
**/.turbo/**
**/.vercel
**/.vercel/**
**/coverage
**/coverage/**
**/dist
**/dist/**
**/node_modules
**/node_modules/**
**/*.tsbuildinfo
**/*.test.*
**/*.spec.*
**/README.md
