NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://ai_job_apply:local_only@localhost:55432/ai_job_apply
REDIS_URL=redis://localhost:6379
# Auth0 is the selected managed provider. Copy the exact environment-specific tenant issuer,
# including its trailing slash; never share tenants between development, staging, and production.
OIDC_ISSUER=https://your-development-tenant.us.auth0.com/
# Stable technical API identifier configured as an Auth0 API audience; independent of branding.
OIDC_AUDIENCE=ai-job-apply-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACE_SAMPLE_RATIO=1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Presentation-only defaults. Do not use the candidate domain as a network origin until ownership
# and public-brand approval are recorded.
NEXT_PUBLIC_PRODUCT_BRAND_NAME=ApplyDash
NEXT_PUBLIC_PRODUCT_BRAND_DOMAIN=applydash.ai

# Source-only saved-answer packet reuse. Requires reviewed key, contracts and Applications 0006.
RESTRICTED_ANSWER_REUSE_ENABLED=false
