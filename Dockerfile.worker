FROM node:24.18.0-trixie-slim@sha256:5301bbf5e8046148348b1dea15436326f43c579031f8d76654a631225bdfe467 AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm contracts:generate && pnpm --filter @ai-job-apply/workflows... build

FROM gcr.io/distroless/nodejs24-debian13:nonroot-amd64@sha256:b1386d556b478c420927eb212236bfb31be9834a4549850a060a6351f7fff514 AS runtime
ENV NODE_ENV=production
WORKDIR /workspace
COPY --from=build --chown=65532:65532 /workspace /workspace
USER 65532:65532
CMD ["backend/workflows/dist/src/start.js"]
