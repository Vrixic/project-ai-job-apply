{
  "name": "@ai-job-apply/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ai-job-apply/api-contracts": "workspace:*"
  },
  "scripts": {
    "build": "node build.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "release:package": "node package-release.mjs",
    "store:assets:validate": "node store/validate-assets.mjs",
    "test:browser": "node ../../scripts/tests/d2-extension-assurance/browser-matrix.mjs",
    "test:browser:single": "node ../../scripts/tests/d2-extension-assurance/browser.mjs",
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "node build.mjs --watch"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.0"
  }
}
