EXTENSION_AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
EXTENSION_AUTH0_CLIENT_ID=YOUR_PUBLIC_APPLICATION_CLIENT_ID
EXTENSION_AUTH0_AUDIENCE=ai-job-apply-api
EXTENSION_API_ORIGIN=https://api.example.test
# Unpacked development only; exact true or false. Store packaging rejects true.
EXTENSION_DEVELOPMENT_CONTRIBUTIONS=false
# Required for default signed mode, not for explicit unpacked development contributions.
EXTENSION_CAPABILITY_POLICY_PUBLIC_KEYS_JSON=ACCOUNTABLE_KEY_ID_TO_BASE64URL_SPKI_JSON
EXTENSION_DETECTOR_ACTIVATION_JSON=REVIEWED_EXACT_VERSION_PROVIDER_VARIANT_DOMAIN_JSON
EXTENSION_PENDING_RETENTION_HOURS=ACCOUNTABLE_INTEGER_FROM_1_TO_720
EXTENSION_UGC_CONTRIBUTION_POLICY_VERSION=ACCOUNTABLE_POLICY_VERSION_REQUIRED_FOR_CONTRIBUTION
