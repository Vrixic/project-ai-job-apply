# Server-only Auth0 configuration for the isolated development tenant.
AUTH0_DOMAIN=your-development-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate 32 random bytes as 64 hexadecimal characters. Never commit the real value.
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=ai-job-apply-api

# Server-to-server BFF target. This is never exposed to browser code.
PLATFORM_API_BASE_URL=http://localhost:4000
