# Server-only Auth0 configuration for the isolated development tenant. AUTH0_DOMAIN is the exact
# lowercase issuer hostname only: no scheme, credentials, port, path, query, fragment, or trailing dot.
AUTH0_DOMAIN=your-development-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate 32 random bytes as 64 hexadecimal characters. Never commit the real value.
AUTH0_SECRET=
# Exact origin only, with no trailing slash/path/query/fragment/credentials. Hosted values require
# HTTPS; HTTP is accepted only for localhost or 127.0.0.1 development.
APP_BASE_URL=http://localhost:3000
# Keep false on Vercel until D1-009 public publication acceptance passes.
PUBLIC_JOB_INDEXING_ENABLED=false
AUTH0_AUDIENCE=ai-job-apply-api

# Server-to-server BFF target. This is never exposed to browser code.
PLATFORM_API_BASE_URL=http://localhost:4000

# Separate public SPA identity for direct native material reads. Default off; requires HTTPS,
# exact Auth0 SPA origin registration and reviewed native DNS/TLS/CORS (ADR-044).
# These are public identifiers, never a client secret or the confidential web client ID.
NEXT_PUBLIC_NATIVE_MATERIAL_UI=disabled
NEXT_PUBLIC_NATIVE_AUTH0_DOMAIN=
NEXT_PUBLIC_NATIVE_AUTH0_CLIENT_ID=
NEXT_PUBLIC_NATIVE_MATERIAL_BASE_HOST=
# Default off; opaque review links for the separately configured unpacked extension.
NEXT_PUBLIC_APPLICATION_EXTENSION_HANDOFF=disabled
