# Use a dedicated Auth0 Regular Web Application with only jobs:moderate delegated access.
# The app requests MFA, reauthentication after 15 minutes, and enforces a one-hour absolute session.
# Configure a tenant Action/policy that honors the requested MFA ACR and emits amr=["mfa"].
# AUTH0_DOMAIN is the exact lowercase issuer hostname only: no scheme, credentials, port, path,
# query, fragment, or trailing dot.
AUTH0_DOMAIN=your-development-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Exact origin only, with no trailing slash/path/query/fragment/credentials. Hosted values require
# HTTPS; HTTP is accepted only for localhost or 127.0.0.1 development.
APP_BASE_URL=http://localhost:3001
AUTH0_AUDIENCE=ai-job-apply-api

# Server-only target. Never expose this value or an access token to browser JavaScript.
PLATFORM_API_BASE_URL=http://localhost:4000
