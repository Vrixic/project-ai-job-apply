{
  "name": "@ai-job-apply/api-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./job-revision-canonical": {
      "types": "./dist/src/job-revision-canonical.d.ts",
      "default": "./dist/src/job-revision-canonical.js"
    },
    "./browser-validators": {
      "types": "./generated/browser-validators.d.ts",
      "default": "./generated/browser-validators.cjs"
    },
    "./job-contribution-canonical": {
      "types": "./dist/src/job-contribution-canonical.d.ts",
      "default": "./dist/src/job-contribution-canonical.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate": "openapi-typescript openapi/platform.v1.json -o generated/platform.ts && node scripts/generate-browser-validators.mjs",
    "test": "vitest run src --exclude=dist/**",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
