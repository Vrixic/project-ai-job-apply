{
  "openapi": "3.1.0",
  "info": {
    "title": "Job Application Platform API",
    "version": "1.0.0",
    "description": "Candidate-facing API. Application tracking ends at confirmed submission."
  },
  "servers": [{ "url": "/v1" }],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Health" } }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Dependencies are ready",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Health" } }
            }
          },
          "503": {
            "description": "A required dependency is unavailable",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getCurrentUser",
        "security": [{ "oidc": ["profile:read"] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CurrentUser" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/me/job-preferences": {
      "get": {
        "operationId": "getJobPreferences",
        "security": [{ "oidc": ["profile:read"] }],
        "responses": {
          "200": {
            "description": "Current job preferences",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/JobPreferenceSet" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "putJobPreferences",
        "security": [{ "oidc": ["profile:write"] }],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PutJobPreferencesRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preferences persisted and readiness operation created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PutJobPreferencesResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/resumes": {
      "get": {
        "operationId": "listResumeDocuments",
        "security": [{ "oidc": ["documents:read"] }],
        "responses": {
          "200": {
            "description": "Resume documents owned by the current candidate",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResumeDocumentCollection" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/resumes/uploads": {
      "post": {
        "operationId": "createResumeUpload",
        "security": [{ "oidc": ["documents:write"] }],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateResumeUploadRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Owner-scoped resume metadata and a bounded direct-upload grant",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateResumeUploadResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/profile/facts": {
      "get": {
        "operationId": "listProfileFacts",
        "security": [{ "oidc": ["profile:read"] }],
        "responses": {
          "200": {
            "description": "Latest profile-fact versions owned by the current candidate",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileFactCollection" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createProfileFact",
        "security": [{ "oidc": ["profile:write"] }],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProfileFactRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "A user-entered, confirmed profile fact was created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProfileFact" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/profile/facts/{factId}": {
      "patch": {
        "operationId": "updateProfileFact",
        "security": [{ "oidc": ["profile:write"] }],
        "parameters": [
          {
            "in": "path",
            "name": "factId",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProfileFactRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A new immutable version of the owned profile fact was created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProfileFact" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/jobs/search": {
      "post": {
        "operationId": "searchCanonicalJobs",
        "security": [{ "oidc": ["jobs:read"] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobSearchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One stable page of active canonical jobs",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": { "type": "string", "enum": ["no-store"] }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobSearchPage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/jobs/{jobId}": {
      "get": {
        "operationId": "getCanonicalJob",
        "security": [{ "oidc": ["jobs:read"] }],
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Active canonical job detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CanonicalJobDetail" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/saved-jobs": {
      "post": {
        "operationId": "createSavedJob",
        "security": [{ "oidc": ["jobs:write"] }],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSavedJobRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The active canonical job is saved for the authenticated owner",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": { "type": "string", "enum": ["no-store"] }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SavedJob" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/saved-jobs/search": {
      "post": {
        "operationId": "listSavedJobs",
        "security": [{ "oidc": ["jobs:read"] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SavedJobSearchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One owner-scoped page of private saved jobs",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": { "type": "string", "enum": ["no-store"] }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SavedJobPage" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/saved-jobs/{savedJobId}": {
      "delete": {
        "operationId": "deleteSavedJob",
        "security": [{ "oidc": ["jobs:write"] }],
        "parameters": [
          {
            "in": "path",
            "name": "savedJobId",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "204": {
            "description": "The owner-scoped saved job is absent",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": { "type": "string", "enum": ["no-store"] }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/entitlements": {
      "get": {
        "operationId": "getEntitlements",
        "security": [{ "oidc": ["profile:read"] }],
        "responses": {
          "200": {
            "description": "The authenticated candidate's derived provider-neutral entitlement status",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": { "type": "string", "enum": ["no-store"] }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EntitlementSummary" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/operations/{operationId}": {
      "get": {
        "operationId": "getOperation",
        "security": [{ "oidc": ["profile:read"] }],
        "parameters": [
          {
            "in": "path",
            "name": "operationId",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation visible to its owner",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Operation" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://identity.invalid/.well-known/openid-configuration"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Request validation failed",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication is required",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated caller lacks the required scope",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "NotFound": {
        "description": "Resource was not found",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "Conflict": {
        "description": "The request conflicts with current resource or idempotency state",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "The request body exceeds the endpoint limit",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "The request body is not JSON",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "The requested capability is temporarily unavailable",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "service", "releaseSha"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded"] },
          "service": { "type": "string" },
          "releaseSha": { "type": "string" }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status", "code", "traceId"],
        "properties": {
          "type": { "type": "string", "format": "uri-reference" },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string" },
          "code": { "type": "string" },
          "traceId": { "type": "string" }
        },
        "additionalProperties": false
      },
      "CurrentUser": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" }
        },
        "additionalProperties": false
      },
      "PutJobPreferencesRequest": {
        "type": "object",
        "required": ["targetRoles", "locations", "workModes", "employmentTypes"],
        "properties": {
          "targetRoles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 100 }
          },
          "locations": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          },
          "workModes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["remote", "hybrid", "on_site"] }
          },
          "employmentTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["full_time", "part_time", "contract", "internship"]
            }
          },
          "salaryMinimum": { "type": "integer", "minimum": 0 },
          "salaryCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "requiresSponsorship": { "type": "boolean" }
        },
        "dependentRequired": {
          "salaryMinimum": ["salaryCurrency"],
          "salaryCurrency": ["salaryMinimum"]
        },
        "additionalProperties": false
      },
      "JobPreferenceSet": {
        "allOf": [
          { "$ref": "#/components/schemas/PutJobPreferencesRequest" },
          {
            "type": "object",
            "required": ["id", "version", "updatedAt"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "version": { "type": "integer", "minimum": 1 },
              "updatedAt": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "PutJobPreferencesResponse": {
        "type": "object",
        "required": ["preferences", "operationId"],
        "properties": {
          "preferences": { "$ref": "#/components/schemas/JobPreferenceSet" },
          "operationId": { "type": "string", "format": "uuid" }
        },
        "additionalProperties": false
      },
      "ResumeMediaType": {
        "type": "string",
        "enum": [
          "application/pdf",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        ]
      },
      "ResumeDocumentStatus": {
        "type": "string",
        "enum": ["awaiting_upload", "scanning", "parsing", "parsed", "rejected", "failed"]
      },
      "CreateResumeUploadRequest": {
        "type": "object",
        "required": ["fileName", "mediaType", "sizeBytes", "sha256"],
        "properties": {
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\u0000-\\u001f\\u007f/\\\\]+$"
          },
          "mediaType": { "$ref": "#/components/schemas/ResumeMediaType" },
          "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 5242880 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      },
      "ResumeDocument": {
        "type": "object",
        "required": [
          "id",
          "fileName",
          "mediaType",
          "sizeBytes",
          "sha256",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\u0000-\\u001f\\u007f/\\\\]+$"
          },
          "mediaType": { "$ref": "#/components/schemas/ResumeMediaType" },
          "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 5242880 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "$ref": "#/components/schemas/ResumeDocumentStatus" },
          "failureCode": {
            "type": "string",
            "enum": [
              "malware_detected",
              "scan_unsupported",
              "scan_failed",
              "object_mismatch",
              "invalid_document",
              "parse_failed"
            ]
          },
          "pageCount": { "type": "integer", "minimum": 1, "maximum": 50 },
          "characterCount": { "type": "integer", "minimum": 1, "maximum": 200000 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "ResumeDocumentCollection": {
        "type": "object",
        "required": ["documents"],
        "properties": {
          "documents": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "#/components/schemas/ResumeDocument" }
          }
        },
        "additionalProperties": false
      },
      "ResumeUploadGrant": {
        "type": "object",
        "required": ["url", "method", "fields", "expiresAt"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "method": { "type": "string", "enum": ["POST"] },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 8192 }
          },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "CreateResumeUploadResponse": {
        "type": "object",
        "required": ["document", "upload"],
        "properties": {
          "document": { "$ref": "#/components/schemas/ResumeDocument" },
          "upload": { "$ref": "#/components/schemas/ResumeUploadGrant" }
        },
        "additionalProperties": false
      },
      "ProfileFactKind": {
        "type": "string",
        "enum": [
          "identity",
          "employment",
          "education",
          "project",
          "skill",
          "certification",
          "preference"
        ]
      },
      "ProfileFactValue": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S" },
          { "type": "number" },
          { "type": "boolean" },
          {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
          }
        ]
      },
      "CreateProfileFactRequest": {
        "type": "object",
        "required": ["kind", "key", "value", "sensitivity"],
        "properties": {
          "kind": { "$ref": "#/components/schemas/ProfileFactKind" },
          "key": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
          "value": { "$ref": "#/components/schemas/ProfileFactValue" },
          "sensitivity": {
            "type": "string",
            "enum": ["standard", "confidential", "restricted"]
          },
          "effectiveFrom": { "type": "string", "format": "date" },
          "effectiveTo": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      },
      "UpdateProfileFactRequest": {
        "type": "object",
        "required": ["expectedVersion"],
        "minProperties": 2,
        "properties": {
          "expectedVersion": { "type": "integer", "minimum": 1 },
          "value": { "$ref": "#/components/schemas/ProfileFactValue" },
          "verification": { "type": "string", "enum": ["confirmed", "rejected"] },
          "sensitivity": {
            "type": "string",
            "enum": ["standard", "confidential", "restricted"]
          },
          "effectiveFrom": { "type": "string", "format": "date" },
          "effectiveTo": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      },
      "ProfileFactSource": {
        "type": "object",
        "required": ["type", "reference"],
        "properties": {
          "type": { "type": "string", "enum": ["user", "resume", "import", "derived"] },
          "reference": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "additionalProperties": false
      },
      "ProfileFactSupportingSpan": {
        "type": "object",
        "required": [
          "documentId",
          "documentVersion",
          "parserVersion",
          "blockIndex",
          "startOffset",
          "endOffset"
        ],
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "documentVersion": { "type": "integer", "minimum": 1 },
          "parserVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
          "blockIndex": { "type": "integer", "minimum": 0, "maximum": 9999 },
          "startOffset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 199999,
            "description": "Zero-based offset within the referenced normalized block"
          },
          "endOffset": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200000,
            "description": "Exclusive offset within the referenced normalized block"
          },
          "page": { "type": "integer", "minimum": 1, "maximum": 50 }
        },
        "additionalProperties": false
      },
      "ProfileFactEvidence": {
        "type": "object",
        "required": ["supportingSpans"],
        "properties": {
          "supportingSpans": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "$ref": "#/components/schemas/ProfileFactSupportingSpan" }
          }
        },
        "additionalProperties": false
      },
      "ProfileFact": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "key",
          "value",
          "verification",
          "sensitivity",
          "source",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "kind": { "$ref": "#/components/schemas/ProfileFactKind" },
          "key": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
          "value": { "$ref": "#/components/schemas/ProfileFactValue" },
          "verification": {
            "type": "string",
            "enum": ["proposed", "confirmed", "rejected"]
          },
          "availability": {
            "oneOf": [
              {
                "type": "object",
                "required": ["state"],
                "properties": { "state": { "type": "string", "const": "available" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["state", "reasonCode"],
                "properties": {
                  "state": { "type": "string", "const": "invalidated" },
                  "reasonCode": { "type": "string", "const": "source_security_hold" }
                },
                "additionalProperties": false
              }
            ]
          },
          "sensitivity": {
            "type": "string",
            "enum": ["standard", "confidential", "restricted"]
          },
          "source": { "$ref": "#/components/schemas/ProfileFactSource" },
          "evidence": { "$ref": "#/components/schemas/ProfileFactEvidence" },
          "effectiveFrom": { "type": "string", "format": "date" },
          "effectiveTo": { "type": "string", "format": "date" },
          "version": { "type": "integer", "minimum": 1 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verification": { "const": "proposed" },
                "source": {
                  "type": "object",
                  "properties": { "type": { "const": "resume" } },
                  "required": ["type"]
                }
              },
              "required": ["verification", "source"]
            },
            "then": {
              "properties": { "evidence": { "$ref": "#/components/schemas/ProfileFactEvidence" } },
              "required": ["evidence"]
            }
          }
        ],
        "additionalProperties": false
      },
      "ProfileFactCollection": {
        "type": "object",
        "required": ["facts", "confirmedCount", "proposedCount"],
        "properties": {
          "facts": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileFact" } },
          "confirmedCount": { "type": "integer", "minimum": 0 },
          "proposedCount": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "JobSearchFilters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "company": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "verifiedWithinDays": { "type": "integer", "minimum": 1, "maximum": 365 }
        },
        "additionalProperties": false
      },
      "JobSearchRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "filters": { "$ref": "#/components/schemas/JobSearchFilters" },
          "sort": { "type": "string", "enum": ["relevance", "freshness"], "default": "relevance" },
          "pageSize": { "type": "integer", "minimum": 1, "maximum": 25, "default": 20 },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
          }
        },
        "additionalProperties": false
      },
      "JobCompanySummary": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "verifiedDomain": { "type": "string", "minLength": 1, "maxLength": 253 }
        },
        "additionalProperties": false
      },
      "JobSourceSummary": {
        "type": "object",
        "required": ["provider", "provenance", "canonicalUrl", "firstObservedAt", "lastVerifiedAt"],
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["greenhouse", "lever", "ashby", "workday", "ugc", "other"]
          },
          "provenance": {
            "type": "string",
            "enum": ["permitted_api", "authorized_fixture", "explicit_ugc"]
          },
          "canonicalUrl": { "type": "string", "format": "uri", "maxLength": 4096 },
          "firstObservedAt": { "type": "string", "format": "date-time" },
          "lastVerifiedAt": { "type": "string", "format": "date-time" },
          "validThrough": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "CanonicalJobSummary": {
        "type": "object",
        "required": [
          "id",
          "company",
          "title",
          "locations",
          "status",
          "firstObservedAt",
          "lastVerifiedAt",
          "expiresAt"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "company": { "$ref": "#/components/schemas/JobCompanySummary" },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "locations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "department": { "type": "string", "minLength": 1, "maxLength": 200 },
          "status": { "type": "string", "enum": ["active"] },
          "firstObservedAt": { "type": "string", "format": "date-time" },
          "lastVerifiedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "JobSearchPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 25,
            "items": { "$ref": "#/components/schemas/CanonicalJobSummary" }
          },
          "nextCursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
          }
        },
        "additionalProperties": false
      },
      "CreateSavedJobRequest": {
        "type": "object",
        "required": ["jobId"],
        "properties": {
          "jobId": { "type": "string", "format": "uuid" }
        },
        "additionalProperties": false
      },
      "SavedJobSearchRequest": {
        "type": "object",
        "properties": {
          "pageSize": { "type": "integer", "minimum": 1, "maximum": 25, "default": 20 },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
          }
        },
        "additionalProperties": false
      },
      "SavedJob": {
        "type": "object",
        "required": ["id", "requestedJobId", "snapshot", "availability", "savedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "requestedJobId": { "type": "string", "format": "uuid" },
          "snapshot": { "$ref": "#/components/schemas/SavedJobSnapshot" },
          "availability": {
            "oneOf": [
              {
                "type": "object",
                "required": ["state", "currentJob"],
                "properties": {
                  "state": { "type": "string", "const": "available" },
                  "currentJob": { "$ref": "#/components/schemas/CanonicalJobSummary" }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["state"],
                "properties": { "state": { "type": "string", "const": "unavailable" } },
                "additionalProperties": false
              }
            ]
          },
          "savedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "SavedJobSnapshot": {
        "type": "object",
        "required": [
          "jobIdAtSave",
          "company",
          "title",
          "locations",
          "firstObservedAt",
          "lastVerifiedAt",
          "expiresAt"
        ],
        "properties": {
          "jobIdAtSave": { "type": "string", "format": "uuid" },
          "company": { "$ref": "#/components/schemas/JobCompanySummary" },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "locations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "department": { "type": "string", "minLength": 1, "maxLength": 200 },
          "firstObservedAt": { "type": "string", "format": "date-time" },
          "lastVerifiedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "SavedJobPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 25,
            "items": { "$ref": "#/components/schemas/SavedJob" }
          },
          "nextCursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
          }
        },
        "additionalProperties": false
      },
      "CanonicalJobDetail": {
        "type": "object",
        "required": [
          "id",
          "company",
          "title",
          "locations",
          "description",
          "status",
          "firstObservedAt",
          "lastVerifiedAt",
          "expiresAt",
          "sources"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "company": { "$ref": "#/components/schemas/JobCompanySummary" },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "locations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "department": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1, "maxLength": 200000 },
          "status": { "type": "string", "enum": ["active"] },
          "firstObservedAt": { "type": "string", "format": "date-time" },
          "lastVerifiedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "validThrough": { "type": "string", "format": "date-time" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/JobSourceSummary" }
          }
        },
        "additionalProperties": false
      },
      "EntitlementSummary": {
        "type": "object",
        "required": ["plan", "accessState", "grants", "version", "evaluatedAt"],
        "properties": {
          "plan": { "type": "string", "enum": ["free", "pro"] },
          "accessState": { "type": "string", "enum": ["active", "grace"] },
          "grants": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              { "const": "profile.manage" },
              { "const": "jobs.search" },
              { "const": "jobs.save" },
              { "const": "applications.history" }
            ],
            "items": false
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "evaluatedAt": { "type": "string", "format": "date-time" },
          "accessThrough": { "type": "string", "format": "date-time" },
          "graceThrough": { "type": "string", "format": "date-time" }
        },
        "oneOf": [
          {
            "properties": {
              "plan": { "const": "free" },
              "accessState": { "const": "active" },
              "accessThrough": false,
              "graceThrough": false
            }
          },
          {
            "required": ["accessThrough"],
            "properties": {
              "plan": { "const": "pro" },
              "accessState": { "const": "active" },
              "accessThrough": { "type": "string", "format": "date-time" },
              "graceThrough": { "type": "string", "format": "date-time" }
            }
          },
          {
            "required": ["accessThrough", "graceThrough"],
            "properties": {
              "plan": { "const": "pro" },
              "accessState": { "const": "grace" },
              "accessThrough": { "type": "string", "format": "date-time" },
              "graceThrough": { "type": "string", "format": "date-time" }
            }
          }
        ],
        "additionalProperties": false
      },
      "ProfileReadiness": {
        "type": "object",
        "required": ["completionPercent", "missingFields", "calculatedAt"],
        "properties": {
          "completionPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "missingFields": {
            "type": "array",
            "items": { "type": "string", "enum": ["locations", "salary"] }
          },
          "calculatedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "Operation": {
        "type": "object",
        "required": ["id", "kind", "state", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "kind": { "type": "string", "enum": ["profile_readiness"] },
          "state": {
            "type": "string",
            "enum": ["queued", "running", "succeeded", "retryable_failure", "failed"]
          },
          "result": { "$ref": "#/components/schemas/ProfileReadiness" },
          "errorCode": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  }
}
