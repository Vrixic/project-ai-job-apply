{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-job-apply.internal/messages/platform.outbox.nudge.v1.json",
  "title": "platform.outbox.nudge.v1",
  "type": "object",
  "required": ["schemaVersion", "eventId", "eventType", "integrity"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "minLength": 1, "maxLength": 128 },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
