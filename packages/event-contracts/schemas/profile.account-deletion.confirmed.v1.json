{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-job-apply.internal/events/profile.account-deletion.confirmed.v1.json",
  "title": "profile.account-deletion.confirmed.v1",
  "type": "object",
  "required": ["deletionRequestId", "operationId", "policyVersion"],
  "properties": {
    "deletionRequestId": { "type": "string", "format": "uuid" },
    "operationId": { "type": "string", "format": "uuid" },
    "policyVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
  },
  "additionalProperties": false
}
