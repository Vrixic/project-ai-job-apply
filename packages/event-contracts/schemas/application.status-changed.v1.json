{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-job-apply.internal/events/application.status_changed.v1.json",
  "title": "application.status_changed.v1",
  "type": "object",
  "required": ["applicationId", "userId", "revision", "status"],
  "properties": {
    "applicationId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "status": {
      "type": "string",
      "enum": [
        "preparing",
        "review_required",
        "approved",
        "submitting",
        "takeover",
        "reconciliation_required",
        "applied",
        "cancelled"
      ]
    }
  },
  "additionalProperties": false
}
