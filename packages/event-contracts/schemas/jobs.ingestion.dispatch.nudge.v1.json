{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-job-apply.internal/messages/jobs.ingestion.dispatch.nudge.v1.json",
  "title": "jobs.ingestion.dispatch.nudge.v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "dispatchId",
    "executionId",
    "checkpointRevision",
    "workflowGeneration",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dispatchId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "executionId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checkpointRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "workflowGeneration": { "type": "integer", "minimum": 1, "maximum": 20 },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
