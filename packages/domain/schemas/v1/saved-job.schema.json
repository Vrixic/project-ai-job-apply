{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-job-apply.internal/domain/v1/saved-job.schema.json",
  "title": "SavedJobV1",
  "type": "object",
  "required": [
    "id",
    "ownerUserId",
    "requestedJobId",
    "resolvedCanonicalJobIdAtSave",
    "jobSnapshot",
    "savedAt"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "ownerUserId": { "type": "string", "format": "uuid" },
    "requestedJobId": { "type": "string", "format": "uuid" },
    "resolvedCanonicalJobIdAtSave": { "type": "string", "format": "uuid" },
    "jobSnapshot": {
      "type": "object",
      "required": [
        "jobIdAtSave",
        "company",
        "title",
        "locations",
        "firstObservedAt",
        "lastVerifiedAt",
        "expiresAt"
      ],
      "properties": {
        "jobIdAtSave": { "type": "string", "format": "uuid" },
        "company": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "verifiedDomain": { "type": "string", "minLength": 1, "maxLength": 253 }
          },
          "additionalProperties": false
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "department": { "type": "string", "minLength": 1, "maxLength": 200 },
        "firstObservedAt": { "type": "string", "format": "date-time" },
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "savedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
