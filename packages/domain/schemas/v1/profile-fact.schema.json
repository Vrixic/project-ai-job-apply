{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-job-apply.internal/domain/v1/profile-fact.schema.json",
  "title": "ProfileFactV1",
  "type": "object",
  "required": [
    "id",
    "userId",
    "kind",
    "key",
    "value",
    "verification",
    "sensitivity",
    "source",
    "version"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "kind": {
      "type": "string",
      "enum": [
        "identity",
        "employment",
        "education",
        "project",
        "skill",
        "certification",
        "preference"
      ]
    },
    "key": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "value": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S" },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
        }
      ]
    },
    "verification": { "type": "string", "enum": ["proposed", "confirmed", "rejected"] },
    "sensitivity": { "type": "string", "enum": ["standard", "confidential", "restricted"] },
    "source": {
      "type": "object",
      "required": ["type", "reference"],
      "properties": {
        "type": { "type": "string", "enum": ["user", "resume", "import", "derived"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "effectiveFrom": { "type": "string", "format": "date" },
    "effectiveTo": { "type": "string", "format": "date" },
    "version": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
