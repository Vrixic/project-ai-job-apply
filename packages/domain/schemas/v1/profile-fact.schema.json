{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-job-apply.internal/domain/v1/profile-fact.schema.json",
  "title": "ProfileFactV1",
  "type": "object",
  "required": [
    "id",
    "userId",
    "kind",
    "key",
    "value",
    "verification",
    "sensitivity",
    "source",
    "version"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "kind": {
      "type": "string",
      "enum": [
        "identity",
        "employment",
        "education",
        "project",
        "skill",
        "certification",
        "preference"
      ]
    },
    "key": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "value": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S" },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
        }
      ]
    },
    "verification": {
      "type": "string",
      "enum": ["proposed", "confirmed", "rejected"]
    },
    "availability": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state"],
          "properties": { "state": { "type": "string", "const": "available" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["state", "reasonCode"],
          "properties": {
            "state": { "type": "string", "const": "invalidated" },
            "reasonCode": { "type": "string", "const": "source_security_hold" }
          },
          "additionalProperties": false
        }
      ]
    },
    "sensitivity": { "type": "string", "enum": ["standard", "confidential", "restricted"] },
    "source": {
      "type": "object",
      "required": ["type", "reference"],
      "properties": {
        "type": { "type": "string", "enum": ["user", "resume", "import", "derived"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["supportingSpans"],
      "properties": {
        "supportingSpans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "documentId",
              "documentVersion",
              "parserVersion",
              "blockIndex",
              "startOffset",
              "endOffset"
            ],
            "properties": {
              "documentId": { "type": "string", "format": "uuid" },
              "documentVersion": { "type": "integer", "minimum": 1 },
              "parserVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
              "blockIndex": { "type": "integer", "minimum": 0, "maximum": 9999 },
              "startOffset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 199999,
                "description": "Zero-based offset within the referenced normalized block"
              },
              "endOffset": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200000,
                "description": "Exclusive offset within the referenced normalized block"
              },
              "page": { "type": "integer", "minimum": 1, "maximum": 50 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "effectiveFrom": { "type": "string", "format": "date" },
    "effectiveTo": { "type": "string", "format": "date" },
    "version": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": { "const": "proposed" },
          "source": {
            "type": "object",
            "properties": { "type": { "const": "resume" } },
            "required": ["type"]
          }
        },
        "required": ["verification", "source"]
      },
      "then": {
        "properties": { "evidence": {} },
        "required": ["evidence"]
      }
    }
  ],
  "additionalProperties": false
}
