{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-job-apply.internal/domain/v1/profile-sections.schema.json",
  "title": "ProfileSectionsV1",
  "description": "Owner-scoped, standard-sensitivity records of the structured candidate Profile (ADR-052). Restricted answers stay in the answer vault.",
  "$defs": {
    "personal": {
      "type": "object",
      "required": ["userId", "version", "origin", "createdAt", "updatedAt"],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[0-9+().\\-\\s]+$"
        },
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "city": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "\\S"
            },
            "region": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "\\S"
            },
            "postalCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "\\S"
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "additionalProperties": false
        },
        "links": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["kind", "url"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["linkedin", "github", "portfolio", "other"]
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 500,
                "pattern": "^https://"
              }
            },
            "additionalProperties": false
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "type": "string",
          "enum": ["entered", "imported"]
        },
        "importId": {
          "type": "string",
          "format": "uuid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "educationEntry": {
      "type": "object",
      "required": [
        "userId",
        "id",
        "school",
        "version",
        "origin",
        "createdAt",
        "updatedAt",
        "displayOrder"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "school": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "degree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "fieldOfStudy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "type": "string",
          "enum": ["entered", "imported"]
        },
        "importId": {
          "type": "string",
          "format": "uuid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "displayOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        }
      },
      "additionalProperties": false
    },
    "workExperienceEntry": {
      "type": "object",
      "required": [
        "userId",
        "id",
        "company",
        "title",
        "startDate",
        "version",
        "origin",
        "createdAt",
        "updatedAt",
        "displayOrder"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "bullets": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "type": "string",
          "enum": ["entered", "imported"]
        },
        "importId": {
          "type": "string",
          "format": "uuid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "displayOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        }
      },
      "additionalProperties": false
    },
    "skillEntry": {
      "type": "object",
      "required": [
        "userId",
        "id",
        "name",
        "version",
        "origin",
        "createdAt",
        "updatedAt",
        "displayOrder"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "\\S"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "type": "string",
          "enum": ["entered", "imported"]
        },
        "importId": {
          "type": "string",
          "format": "uuid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "displayOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        }
      },
      "additionalProperties": false
    },
    "applicationAnswer": {
      "type": "object",
      "required": [
        "userId",
        "id",
        "question",
        "answer",
        "version",
        "origin",
        "createdAt",
        "updatedAt",
        "questionKey"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "type": "string",
          "enum": ["entered", "imported"]
        },
        "importId": {
          "type": "string",
          "format": "uuid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "questionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "entryReference": {
      "oneOf": [
        {
          "type": "object",
          "required": ["section", "version"],
          "properties": {
            "section": {
              "type": "string",
              "const": "personal"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["section", "entryId", "version"],
          "properties": {
            "section": {
              "type": "string",
              "enum": ["education", "workExperience", "skill", "applicationAnswer"]
            },
            "entryId": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "importDraft": {
      "type": "object",
      "required": ["userId", "id", "importId", "section", "values", "createdAt"],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "importId": {
          "type": "string",
          "format": "uuid"
        },
        "section": {
          "type": "string",
          "enum": ["personal", "education", "workExperience", "skill"]
        },
        "values": {
          "$ref": "#/$defs/importDraftValues"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "importDraftValues": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "fullName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 254
            },
            "phone": {
              "type": "string",
              "minLength": 3,
              "maxLength": 40,
              "pattern": "^[0-9+().\\-\\s]+$"
            },
            "address": {
              "type": "object",
              "properties": {
                "street": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                "city": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "region": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "postalCode": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "\\S"
                },
                "country": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                }
              },
              "additionalProperties": false
            },
            "links": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": ["kind", "url"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["linkedin", "github", "portfolio", "other"]
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 500,
                    "pattern": "^https://"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["school"],
          "properties": {
            "school": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "degree": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "fieldOfStudy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "startDate": {
              "type": "string",
              "format": "date"
            },
            "endDate": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["company", "title", "startDate"],
          "properties": {
            "company": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "location": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "startDate": {
              "type": "string",
              "format": "date"
            },
            "endDate": {
              "type": "string",
              "format": "date"
            },
            "bullets": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "entryOrigin": {
      "type": "string",
      "enum": ["entered", "imported"]
    }
  }
}
