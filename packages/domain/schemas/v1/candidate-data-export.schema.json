{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-job-apply.internal/domain/v1/candidate-data-export.schema.json",
  "title": "CandidateDataExportV1",
  "type": "object",
  "required": [
    "schemaVersion",
    "format",
    "exportId",
    "policyVersion",
    "generatedAt",
    "candidate",
    "profile",
    "documents",
    "jobs",
    "matching",
    "billing",
    "audit"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "candidate-data-export-v1" },
    "exportId": { "$ref": "#/$defs/uuid" },
    "policyVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "generatedAt": { "$ref": "#/$defs/dateTime" },
    "candidate": {
      "type": "object",
      "required": ["createdAt", "connectedAccounts"],
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 320 },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "connectedAccounts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["provider", "linkedAt", "lastSeenAt"],
            "properties": {
              "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
              "linkedAt": { "$ref": "#/$defs/dateTime" },
              "lastSeenAt": { "$ref": "#/$defs/dateTime" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["preferences", "facts"],
      "properties": {
        "preferences": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/preferences" }] },
        "facts": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/profileFact" } },
        "restrictedAnswers": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/restrictedAnswerMetadata" }
        },
        "contributionConsents": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/contributionConsent" }
        }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "object",
      "required": ["resumes"],
      "properties": {
        "resumes": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/resume" } }
      },
      "additionalProperties": false
    },
    "jobs": {
      "type": "object",
      "required": ["reports"],
      "properties": {
        "reports": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/jobReport" } },
        "contributions": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/jobContribution" }
        }
      },
      "additionalProperties": false
    },
    "matching": {
      "type": "object",
      "required": ["savedJobs"],
      "properties": {
        "savedJobs": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/savedJob" }
        },
        "privateSavedPageCaptures": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/privateSavedPageCapture" }
        }
      },
      "additionalProperties": false
    },
    "billing": {
      "type": "object",
      "required": ["entitlement"],
      "properties": { "entitlement": { "$ref": "#/$defs/entitlement" } },
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "required": ["schemaVersion", "cases", "caseEvents", "contributorReputationEvidence"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "cases": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/trustCase" }
        },
        "caseEvents": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/trustCaseEvent" }
        },
        "contributorReputationEvidence": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/trustContributorReputationEvidence" }
        }
      },
      "additionalProperties": false
    },
    "applications": {
      "type": "object",
      "required": ["schemaVersion", "applications", "packets", "approvals", "attempts", "history"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "applications": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/applicationsApplication" }
        },
        "packets": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/applicationsPacket" }
        },
        "approvals": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/applicationsApproval" }
        },
        "attempts": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/applicationsAttempt" }
        },
        "history": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/applicationsHistoryEntry" }
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["events"],
      "properties": {
        "events": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/auditEvent" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "d2PolicyVersion": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"
    },
    "contributionConsent": {
      "type": "object",
      "required": [
        "consentId",
        "purpose",
        "client",
        "documentVersion",
        "policyVersion",
        "state",
        "grantedAt",
        "recordedAt"
      ],
      "properties": {
        "consentId": {
          "$ref": "#/$defs/uuid"
        },
        "purpose": {
          "const": "ugc_contribution"
        },
        "client": {
          "const": "extension"
        },
        "documentVersion": {
          "$ref": "#/$defs/d2PolicyVersion"
        },
        "policyVersion": {
          "$ref": "#/$defs/d2PolicyVersion"
        },
        "state": {
          "enum": ["granted", "revoked", "superseded"]
        },
        "grantedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "expiresAt": {
          "$ref": "#/$defs/dateTime"
        },
        "recordedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "replacementConsentId": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "superseded"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": { "replacementConsentId": { "$ref": "#/$defs/uuid" } },
            "required": ["replacementConsentId"]
          },
          "else": {
            "properties": {
              "replacementConsentId": false
            }
          }
        }
      ]
    },
    "contributionSource": {
      "type": "object",
      "required": ["provider", "pageVariant", "sourceUrl", "adapterVersion"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["greenhouse", "lever", "ashby"]
        },
        "pageVariant": {
          "type": "string",
          "enum": ["greenhouse-board-v1", "lever-posting-v1", "ashby-job-board-v1"]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096,
          "pattern": "^https://[^#]+$"
        },
        "externalJobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "adapterVersion": {
          "type": "string",
          "const": "d2-job-page-v1"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "greenhouse"
              }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "pageVariant": {
                "type": "string",
                "const": "greenhouse-board-v1"
              },
              "sourceUrl": {
                "type": "string",
                "pattern": "^https://(?:boards\\.greenhouse\\.io|job-boards\\.greenhouse\\.io)/[A-Za-z0-9._~-]+/jobs/[A-Za-z0-9._~-]+/?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "lever"
              }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "pageVariant": {
                "type": "string",
                "const": "lever-posting-v1"
              },
              "sourceUrl": {
                "type": "string",
                "pattern": "^https://(?:jobs\\.lever\\.co|jobs\\.eu\\.lever\\.co)/[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+/?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "ashby"
              }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "pageVariant": {
                "type": "string",
                "const": "ashby-job-board-v1"
              },
              "sourceUrl": {
                "type": "string",
                "pattern": "^https://jobs\\.ashbyhq\\.com/[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+/?$"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "contributionState": {
      "enum": [
        "queued",
        "normalized",
        "awaiting_independent_verification",
        "independently_verified",
        "awaiting_trust",
        "rejected",
        "ready_for_publication",
        "published",
        "consent_invalid",
        "withdrawn",
        "taken_down",
        "removed"
      ]
    },
    "jobContribution": {
      "type": "object",
      "required": [
        "id",
        "state",
        "source",
        "posting",
        "observation",
        "approval",
        "processingHistory",
        "trustHistory",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "state": {
          "$ref": "#/$defs/contributionState"
        },
        "client": {
          "type": "object",
          "required": ["surface", "version"],
          "properties": {
            "surface": {
              "const": "browser_extension"
            },
            "version": {
              "type": "string",
              "minLength": 5,
              "maxLength": 32,
              "pattern": "^(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})(?:-[0-9A-Za-z][0-9A-Za-z.-]{0,15})?$"
            }
          },
          "additionalProperties": false
        },
        "source": {
          "$ref": "#/$defs/contributionSource"
        },
        "posting": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "companyName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "\\S"
            },
            "locations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "\\S"
              }
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000,
              "pattern": "\\S"
            },
            "department": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "applicationUrl": {
              "type": "string",
              "format": "uri",
              "maxLength": 4096,
              "pattern": "^https://[^#]+$"
            },
            "employmentType": {
              "type": "string",
              "enum": ["full_time", "part_time", "contract", "internship", "unknown"]
            },
            "workMode": {
              "type": "string",
              "enum": ["remote", "hybrid", "on_site", "unknown"]
            }
          },
          "additionalProperties": false
        },
        "observation": {
          "type": "object",
          "required": ["observedAt"],
          "properties": {
            "observedAt": {
              "$ref": "#/$defs/dateTime"
            }
          },
          "additionalProperties": false
        },
        "approval": {
          "type": "object",
          "required": ["consentId", "consentVersion", "policyVersion", "approvedAt"],
          "properties": {
            "consentId": {
              "$ref": "#/$defs/uuid"
            },
            "consentVersion": {
              "const": "ugc-contribution-preview.v1"
            },
            "policyVersion": {
              "$ref": "#/$defs/d2PolicyVersion"
            },
            "approvedAt": {
              "$ref": "#/$defs/dateTime"
            }
          },
          "additionalProperties": false
        },
        "processingHistory": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["state", "reasonCode", "policyVersion", "occurredAt"],
            "properties": {
              "state": {
                "$ref": "#/$defs/contributionState"
              },
              "reasonCode": {
                "enum": [
                  "normalization_complete",
                  "consent_not_current",
                  "provider_temporarily_unavailable",
                  "provider_observation_mismatch",
                  "provider_posting_closed",
                  "provider_probable_duplicate",
                  "independent_verification_complete",
                  "trust_review_required",
                  "trust_policy_rejected",
                  "trust_withdrawal",
                  "trust_takedown",
                  "publication_gates_complete",
                  "publication_complete",
                  "terminal_reconciliation_complete"
                ]
              },
              "policyVersion": {
                "$ref": "#/$defs/d2PolicyVersion"
              },
              "occurredAt": {
                "$ref": "#/$defs/dateTime"
              }
            },
            "additionalProperties": false
          }
        },
        "trustHistory": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["status", "policyVersion", "decidedAt"],
            "properties": {
              "status": {
                "enum": ["accepted", "rejected", "withdrawn", "taken_down"]
              },
              "policyVersion": {
                "$ref": "#/$defs/d2PolicyVersion"
              },
              "decidedAt": {
                "$ref": "#/$defs/dateTime"
              }
            },
            "additionalProperties": false
          }
        },
        "publication": {
          "type": "object",
          "required": ["state", "createdAt", "updatedAt"],
          "properties": {
            "jobId": {
              "$ref": "#/$defs/uuid"
            },
            "state": {
              "enum": ["prepared", "applied"]
            },
            "createdAt": {
              "$ref": "#/$defs/dateTime"
            },
            "updatedAt": {
              "$ref": "#/$defs/dateTime"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "state": { "const": "applied" } }, "required": ["state"] },
              "then": {
                "properties": { "jobId": { "$ref": "#/$defs/uuid" } },
                "required": ["jobId"]
              }
            }
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/dateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/dateTime"
        }
      },
      "additionalProperties": false
    },
    "privateSavedPageCapture": {
      "type": "object",
      "required": [
        "id",
        "provider",
        "pageVariant",
        "sourceUrl",
        "adapterVersion",
        "title",
        "company",
        "location",
        "description",
        "externalJobId",
        "capturedAt",
        "savedAt",
        "resolution"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "provider": {
          "type": "string",
          "enum": ["greenhouse", "lever", "ashby"]
        },
        "pageVariant": {
          "type": "string",
          "enum": ["greenhouse-board-v1", "lever-posting-v1", "ashby-job-board-v1"]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^#]+$"
        },
        "adapterVersion": {
          "type": "string",
          "const": "d2-job-page-v1"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "company": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "\\S"
            }
          ]
        },
        "location": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            }
          ]
        },
        "description": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000,
              "pattern": "\\S"
            }
          ]
        },
        "externalJobId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          ]
        },
        "capturedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "savedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "resolution": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": ["canonicalJobId", "verificationEvidenceId", "resolvedAt"],
              "properties": {
                "canonicalJobId": {
                  "$ref": "#/$defs/uuid"
                },
                "verificationEvidenceId": {
                  "$ref": "#/$defs/uuid"
                },
                "resolvedAt": {
                  "$ref": "#/$defs/dateTime"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "greenhouse"
              }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "pageVariant": {
                "type": "string",
                "const": "greenhouse-board-v1"
              },
              "sourceUrl": {
                "type": "string",
                "pattern": "^https://(?:boards\\.greenhouse\\.io|job-boards\\.greenhouse\\.io)/[A-Za-z0-9._~-]+/jobs/[A-Za-z0-9._~-]+/?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "lever"
              }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "pageVariant": {
                "type": "string",
                "const": "lever-posting-v1"
              },
              "sourceUrl": {
                "type": "string",
                "pattern": "^https://(?:jobs\\.lever\\.co|jobs\\.eu\\.lever\\.co)/[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+/?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "ashby"
              }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "pageVariant": {
                "type": "string",
                "const": "ashby-job-board-v1"
              },
              "sourceUrl": {
                "type": "string",
                "pattern": "^https://jobs\\.ashbyhq\\.com/[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+/?$"
              }
            }
          }
        }
      ]
    },
    "uuid": { "type": "string", "format": "uuid" },
    "dateTime": { "type": "string", "format": "date-time" },
    "preferences": {
      "type": "object",
      "required": [
        "version",
        "targetRoles",
        "locations",
        "workModes",
        "employmentTypes",
        "updatedAt"
      ],
      "properties": {
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "targetRoles": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "locations": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "workModes": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["remote", "hybrid", "on_site"] }
        },
        "employmentTypes": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["full_time", "part_time", "contract", "internship"] }
        },
        "salaryMinimum": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "salaryCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "restrictedAnswerMetadata": {
      "type": "object",
      "required": [
        "id",
        "fieldKey",
        "version",
        "valueType",
        "sensitivity",
        "state",
        "confirmedAt",
        "createdAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "fieldKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "context": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "valueType": { "enum": ["string", "text", "boolean", "date", "decimal", "enum"] },
        "sensitivity": { "enum": ["confidential", "restricted"] },
        "state": { "enum": ["active", "deleted"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 3900 },
        "confirmedAt": { "$ref": "#/$defs/dateTime" },
        "expiresAt": { "$ref": "#/$defs/dateTime" },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "deleted" } }, "required": ["state"] },
          "then": { "properties": { "value": false } }
        },
        {
          "if": { "properties": { "value": {} }, "required": ["value"] },
          "then": {
            "properties": {
              "fieldKey": {
                "enum": [
                  "authorization.us_authorized",
                  "authorization.sponsorship_required",
                  "authorization.export_control",
                  "disclosure.non_compete",
                  "disclosure.conflict_of_interest",
                  "demographic.gender",
                  "demographic.race_ethnicity",
                  "demographic.veteran",
                  "demographic.disability"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "profileFact": {
      "type": "object",
      "required": [
        "id",
        "version",
        "kind",
        "key",
        "value",
        "verification",
        "sensitivity",
        "sourceType",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "kind": {
          "enum": [
            "identity",
            "employment",
            "education",
            "project",
            "skill",
            "certification",
            "preference"
          ]
        },
        "key": { "type": "string", "minLength": 1, "maxLength": 120 },
        "value": {
          "oneOf": [
            { "type": "string", "maxLength": 10000 },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 1000 } }
          ]
        },
        "verification": { "enum": ["proposed", "confirmed", "rejected"] },
        "availability": { "enum": ["available", "invalidated"] },
        "sensitivity": { "enum": ["standard", "confidential", "restricted"] },
        "sourceType": { "enum": ["user", "resume", "import", "derived"] },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveTo": { "type": "string", "format": "date" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "required": [
        "id",
        "fileName",
        "mediaType",
        "sizeBytes",
        "sha256",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mediaType": {
          "enum": [
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          ]
        },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": {
          "enum": ["awaiting_upload", "scanning", "parsing", "parsed", "rejected", "failed"]
        },
        "failureCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "pageCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "characterCount": { "type": "integer", "minimum": 0, "maximum": 5000000 },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "jobReport": {
      "type": "object",
      "required": ["id", "requestedJobId", "canonicalJobId", "reason", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "requestedJobId": { "$ref": "#/$defs/uuid" },
        "canonicalJobId": { "$ref": "#/$defs/uuid" },
        "reason": {
          "enum": [
            "job_closed",
            "job_not_found",
            "job_inaccurate",
            "suspected_scam",
            "duplicate_listing",
            "other_catalog_issue"
          ]
        },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "savedJob": {
      "type": "object",
      "required": ["id", "requestedJobId", "canonicalJobIdAtSave", "savedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "requestedJobId": { "$ref": "#/$defs/uuid" },
        "canonicalJobIdAtSave": { "$ref": "#/$defs/uuid" },
        "titleAtSave": { "type": "string", "minLength": 1, "maxLength": 240 },
        "companyNameAtSave": { "type": "string", "minLength": 1, "maxLength": 200 },
        "locationsAtSave": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "savedAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "entitlement": {
      "type": "object",
      "required": ["plan", "version", "effectiveAt"],
      "properties": {
        "plan": { "enum": ["free", "pro"] },
        "version": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "effectiveAt": { "$ref": "#/$defs/dateTime" },
        "accessThrough": { "$ref": "#/$defs/dateTime" },
        "graceThrough": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "trustCase": {
      "type": "object",
      "required": [
        "id",
        "contributionId",
        "policyVersion",
        "appealWindowMilliseconds",
        "state",
        "version",
        "appealCount",
        "adverseState",
        "adverseDecisionAt",
        "appealDeadlineAt",
        "pendingAppealEvidenceDigestSha256",
        "lastAction",
        "lastActorKind",
        "lastReasonCode",
        "lastEvidenceDigestSha256",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "contributionId": { "$ref": "#/$defs/uuid" },
        "policyVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$" },
        "appealWindowMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000000
        },
        "state": { "$ref": "#/$defs/trustCaseState" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "appealCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "adverseState": {
          "oneOf": [{ "type": "null" }, { "enum": ["rejected", "taken_down"] }]
        },
        "adverseDecisionAt": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dateTime" }]
        },
        "appealDeadlineAt": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dateTime" }]
        },
        "pendingAppealEvidenceDigestSha256": { "$ref": "#/$defs/nullableSha256" },
        "independentEvidenceDigestSha256": { "$ref": "#/$defs/nullableSha256" },
        "lastAction": { "$ref": "#/$defs/trustAction" },
        "lastActorKind": { "$ref": "#/$defs/trustActorKind" },
        "lastReasonCode": { "$ref": "#/$defs/trustReasonCode" },
        "lastEvidenceDigestSha256": { "$ref": "#/$defs/nullableSha256" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "trustCaseEvent": {
      "type": "object",
      "required": [
        "caseId",
        "caseVersion",
        "contributionId",
        "policyVersion",
        "priorState",
        "resultingState",
        "action",
        "actorKind",
        "reasonCode",
        "evidenceDigestSha256",
        "occurredAt"
      ],
      "properties": {
        "eventId": { "$ref": "#/$defs/uuid" },
        "caseId": { "$ref": "#/$defs/uuid" },
        "caseVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "contributionId": { "$ref": "#/$defs/uuid" },
        "policyVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$" },
        "priorState": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/trustCaseState" }]
        },
        "resultingState": { "$ref": "#/$defs/trustCaseState" },
        "action": { "$ref": "#/$defs/trustAction" },
        "actorKind": { "$ref": "#/$defs/trustActorKind" },
        "reasonCode": { "$ref": "#/$defs/trustReasonCode" },
        "evidenceDigestSha256": { "$ref": "#/$defs/nullableSha256" },
        "independentEvidenceDigestSha256": { "$ref": "#/$defs/nullableSha256" },
        "occurredAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "trustContributorReputationEvidence": {
      "type": "object",
      "required": [
        "id",
        "caseId",
        "caseVersion",
        "contributionId",
        "signalCode",
        "referenceDigestSha256",
        "occurredAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "caseId": { "$ref": "#/$defs/uuid" },
        "caseVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "contributionId": { "$ref": "#/$defs/uuid" },
        "signalCode": {
          "enum": [
            "contributor_submission_verified",
            "contributor_submission_incorrect",
            "contributor_abuse_detected",
            "adverse_decision_reversed"
          ]
        },
        "referenceDigestSha256": { "$ref": "#/$defs/sha256" },
        "occurredAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "trustCaseState": {
      "enum": ["needs_review", "accepted", "rejected", "appeal_pending", "withdrawn", "taken_down"]
    },
    "trustAction": {
      "enum": [
        "opened",
        "review_accepted",
        "review_rejected",
        "withdrawn",
        "taken_down",
        "appeal_filed",
        "appeal_upheld",
        "appeal_reversed"
      ]
    },
    "trustActorKind": { "enum": ["system", "reviewer", "contributor"] },
    "trustReasonCode": {
      "enum": [
        "queued_for_review",
        "independently_verified",
        "insufficient_evidence",
        "content_mismatch",
        "malicious_or_deceptive",
        "license_or_policy_block",
        "contributor_withdrawal",
        "verified_requester_takedown",
        "credible_safety_risk",
        "rights_or_policy_violation",
        "development_test_removal",
        "new_or_corrected_evidence",
        "decision_upheld",
        "decision_reversed"
      ]
    },
    "applicationsStatus": {
      "enum": [
        "preparing",
        "review_required",
        "approved",
        "submitting",
        "takeover",
        "reconciliation_required",
        "applied",
        "cancelled"
      ]
    },
    "applicationsApplication": {
      "type": "object",
      "required": ["id", "canonicalJobId", "status", "revision", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "canonicalJobId": { "$ref": "#/$defs/uuid" },
        "status": { "$ref": "#/$defs/applicationsStatus" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "currentPacketId": { "$ref": "#/$defs/uuid" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "applicationsPacketField": {
      "type": "object",
      "required": [
        "fieldKey",
        "value",
        "origin",
        "sourceFactIds",
        "confidence",
        "disposition",
        "reasons",
        "requiresReview"
      ],
      "properties": {
        "fieldKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "maxLength": 20000 },
            { "type": "number" },
            { "type": "boolean" },
            {
              "type": "array",
              "maxItems": 100,
              "items": {
                "oneOf": [
                  { "type": "string", "maxLength": 2000 },
                  { "type": "number" },
                  { "type": "boolean" }
                ]
              }
            }
          ]
        },
        "origin": {
          "enum": ["confirmed_fact", "answer_vault", "user_entered", "generated", "derived"]
        },
        "sourceFactIds": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/uuid" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "disposition": { "enum": ["auto", "review", "user_action"] },
        "reasons": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "enum": [
              "restricted_answer",
              "explicit_each_time",
              "never_infer",
              "unsupported_value",
              "unconfirmed_source",
              "low_confidence",
              "generated_content",
              "unknown_field",
              "direct_user_action"
            ]
          }
        },
        "requiresReview": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "applicationsPacket": {
      "type": "object",
      "required": [
        "id",
        "applicationId",
        "version",
        "packetHash",
        "jobRevision",
        "createdAt",
        "fields"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "applicationId": { "$ref": "#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "packetHash": { "$ref": "#/$defs/sha256" },
        "jobRevision": { "$ref": "#/$defs/sha256" },
        "formAdapterId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "formVariantId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "formHash": { "$ref": "#/$defs/sha256" },
        "resumeHash": { "$ref": "#/$defs/sha256" },
        "coverLetterHash": { "$ref": "#/$defs/sha256" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "fields": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/applicationsPacketField" }
        }
      },
      "additionalProperties": false
    },
    "applicationsApproval": {
      "type": "object",
      "required": [
        "id",
        "packetId",
        "applicationId",
        "packetHash",
        "acknowledgedFieldKeys",
        "approvedAt",
        "expiresAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "packetId": { "$ref": "#/$defs/uuid" },
        "applicationId": { "$ref": "#/$defs/uuid" },
        "packetHash": { "$ref": "#/$defs/sha256" },
        "acknowledgedFieldKeys": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "approvedAt": { "$ref": "#/$defs/dateTime" },
        "expiresAt": { "$ref": "#/$defs/dateTime" },
        "invalidatedAt": { "$ref": "#/$defs/dateTime" },
        "invalidationReason": {
          "enum": [
            "packet_hash_mismatch",
            "approval_expired",
            "job_changed",
            "form_changed",
            "resume_changed",
            "cover_letter_changed",
            "superseded",
            "attempt_requires_review",
            "cancelled"
          ]
        }
      },
      "additionalProperties": false
    },
    "applicationsAttempt": {
      "type": "object",
      "required": [
        "id",
        "applicationId",
        "packetId",
        "sequence",
        "status",
        "adapterId",
        "adapterVersion",
        "startedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "applicationId": { "$ref": "#/$defs/uuid" },
        "packetId": { "$ref": "#/$defs/uuid" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "status": {
          "enum": [
            "started",
            "dispatched",
            "confirmed",
            "ambiguous",
            "failed_no_effect",
            "failed_requires_review",
            "taken_over",
            "abandoned",
            "reconciled_not_submitted"
          ]
        },
        "adapterId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "startedAt": { "$ref": "#/$defs/dateTime" },
        "dispatchedAt": { "$ref": "#/$defs/dateTime" },
        "resolvedAt": { "$ref": "#/$defs/dateTime" },
        "evidenceKind": {
          "enum": ["provider_confirmation_page", "provider_api_response", "user_attested"]
        },
        "evidenceObservedAt": { "$ref": "#/$defs/dateTime" },
        "evidenceProviderReference": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "applicationsHistoryEntry": {
      "type": "object",
      "required": ["applicationId", "seq", "kind", "toStatus", "occurredAt"],
      "properties": {
        "applicationId": { "$ref": "#/$defs/uuid" },
        "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "kind": {
          "enum": [
            "application_created",
            "packet_created",
            "approval_recorded",
            "approval_invalidated",
            "attempt_started",
            "attempt_dispatched",
            "attempt_failed_no_effect",
            "attempt_failed_requires_review",
            "takeover_requested",
            "takeover_abandoned",
            "submission_ambiguous",
            "reconciliation_recorded",
            "submission_confirmed",
            "application_cancelled"
          ]
        },
        "fromStatus": { "$ref": "#/$defs/applicationsStatus" },
        "toStatus": { "$ref": "#/$defs/applicationsStatus" },
        "packetId": { "$ref": "#/$defs/uuid" },
        "attemptId": { "$ref": "#/$defs/uuid" },
        "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "occurredAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "auditEvent": {
      "type": "object",
      "required": ["owner", "action", "resourceType", "occurredAt"],
      "properties": {
        "owner": {
          "enum": [
            "identity",
            "profile",
            "documents",
            "jobs",
            "matching",
            "billing",
            "trust",
            "applications"
          ]
        },
        "action": { "type": "string", "minLength": 1, "maxLength": 120 },
        "resourceType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "resourceId": { "$ref": "#/$defs/uuid" },
        "occurredAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    }
  }
}
