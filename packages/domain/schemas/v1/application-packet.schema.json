{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-job-apply.internal/domain/v1/application-packet.schema.json",
  "title": "ApplicationPacketV1",
  "type": "object",
  "required": [
    "id",
    "userId",
    "canonicalJobId",
    "version",
    "state",
    "fields",
    "artifactHashes",
    "packetHash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "canonicalJobId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": ["preparing", "review_required", "approved", "expired", "cancelled"]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fieldKey", "value", "sourceFactIds", "confidence", "review"],
        "properties": {
          "fieldKey": {
            "type": "string"
          },
          "value": {},
          "sourceFactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "review": {
            "type": "string",
            "enum": ["not_required", "required", "approved"]
          },
          "origin": {
            "type": "string",
            "enum": ["confirmed_fact", "answer_vault", "user_entered", "generated", "derived"]
          },
          "disposition": {
            "type": "string",
            "enum": ["auto", "review", "user_action"]
          },
          "reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "restricted_answer",
                "explicit_each_time",
                "never_infer",
                "unsupported_value",
                "unconfirmed_source",
                "low_confidence",
                "generated_content",
                "unknown_field",
                "direct_user_action"
              ]
            }
          },
          "requiresReview": {
            "type": "boolean"
          },
          "vaultReference": {
            "type": "object",
            "required": [
              "id",
              "version",
              "context",
              "questionHash",
              "meaningConfirmed",
              "validUntilEpochMs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "context": {
                "type": "string",
                "maxLength": 120
              },
              "questionHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "meaningConfirmed": {
                "const": true
              },
              "validUntilEpochMs": {
                "type": ["number", "null"]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": ["vaultReference"],
              "properties": {
                "vaultReference": {}
              }
            },
            "then": {
              "properties": {
                "origin": {
                  "const": "answer_vault"
                },
                "requiresReview": {
                  "const": true
                },
                "disposition": {
                  "const": "review"
                }
              }
            }
          },
          {
            "if": {
              "required": ["fieldKey"],
              "properties": {
                "fieldKey": {
                  "enum": ["documents.cover_letter", "documents.resume"]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "artifactHashes": {
      "type": "object",
      "properties": {
        "resume": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "coverLetter": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "form": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "packetHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "approvalConsentId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "jobRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "form": {
      "type": "object",
      "required": ["adapterId", "variantId", "formHash"],
      "properties": {
        "adapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "variantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "formHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
