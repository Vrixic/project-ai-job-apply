{
  "name": "@ai-job-apply/ats-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extract": {
      "types": "./dist/extract.d.ts",
      "default": "./dist/extract.js"
    },
    "./observed-form": {
      "types": "./dist/observed-form.d.ts",
      "default": "./dist/observed-form.js"
    },
    "./plan": {
      "types": "./dist/plan.d.ts",
      "default": "./dist/plan.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./mapping": {
      "types": "./dist/mapping.d.ts",
      "default": "./dist/mapping.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run src --exclude=dist/**",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "jsdom": "30.1.2"
  }
}
