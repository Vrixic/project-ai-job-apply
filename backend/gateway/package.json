{
  "name": "@ai-job-apply/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lambda": "pnpm --filter @ai-job-apply/gateway... build && node ../../scripts/build-gateway-lambda.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "conformance:lambda-dark": "tsx src/dark-conformance-bridge.ts",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/start.ts",
    "start": "node dist/src/start.js",
    "test": "vitest run src --exclude=dist/** --testTimeout=60000 --hookTimeout=60000",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1103.0",
    "@ai-job-apply/api-contracts": "workspace:*",
    "@ai-job-apply/auth": "workspace:*",
    "@ai-job-apply/config": "workspace:*",
    "@ai-job-apply/observability": "workspace:*",
    "@ai-job-apply/profile-service": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "fastify": "5.11.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "3.1103.0",
    "@ai-job-apply/domain": "workspace:*",
    "@types/aws-lambda": "8.10.162",
    "tsx": "4.23.5",
    "uuid": "14.0.1"
  }
}
