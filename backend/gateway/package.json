{
  "name": "@ai-job-apply/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lambda": "pnpm --filter @ai-job-apply/gateway... build && node ../../scripts/build-gateway-lambda.mjs",
    "build:public-job-lambda": "pnpm --filter @ai-job-apply/gateway... build && node ../../scripts/build-public-job-lambda.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/start.ts",
    "start": "node dist/src/start.js",
    "test": "vitest run src --exclude=dist/** --testTimeout=60000 --hookTimeout=60000",
    "test:assurance": "vitest run src/d1-api-assurance-harness.test.ts --testTimeout=60000 --hookTimeout=60000",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-job-apply/api-contracts": "workspace:*",
    "@ai-job-apply/auth": "workspace:*",
    "@ai-job-apply/billing-service": "workspace:*",
    "@ai-job-apply/config": "workspace:*",
    "@ai-job-apply/documents-service": "workspace:*",
    "@ai-job-apply/jobs-service": "workspace:*",
    "@ai-job-apply/matching-service": "workspace:*",
    "@ai-job-apply/observability": "workspace:*",
    "@ai-job-apply/profile-service": "workspace:*",
    "@ai-job-apply/trust-service": "workspace:*",
    "@aws-sdk/client-kms": "3.1131.0",
    "@aws-sdk/client-lambda": "3.1131.0",
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/client-sqs": "3.1131.0",
    "@aws-sdk/rds-signer": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "fastify": "5.12.4",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@ai-job-apply/domain": "workspace:*",
    "@types/aws-lambda": "8.10.163",
    "tsx": "4.23.13",
    "uuid": "14.0.2"
  }
}
