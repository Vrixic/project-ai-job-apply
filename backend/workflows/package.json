{
  "name": "@ai-job-apply/workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/profile-readiness-durable.d.ts",
      "default": "./dist/src/profile-readiness-durable.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lambda": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-workflow-ingress-lambda.mjs && node ../../scripts/build-profile-readiness-lambdas.mjs && node ../../scripts/build-ingestion-lambdas.mjs && node ../../scripts/build-d2-community-lambda.mjs && node ../../scripts/build-applications-attempt-recovery-lambda.mjs",
    "build:lambda:applications-attempt-recovery": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-applications-attempt-recovery-lambda.mjs",
    "build:lambda:d2-community": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-d2-community-lambda.mjs",
    "build:lambda:deletion-restore": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-candidate-deletion-restore-lambda.mjs",
    "build:lambda:ingestion": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-ingestion-lambdas.mjs",
    "build:lambda:ingress": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-workflow-ingress-lambda.mjs",
    "build:lambda:profile": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-profile-readiness-lambdas.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/start.ts",
    "preflight:provider-source": "node --import tsx src/run-provider-source-preflight.ts",
    "replay:candidate-deletions": "node ../../scripts/run-powershell.mjs --require-core -File ../../scripts/operate-development-candidate-deletion-replay.ps1",
    "start": "node dist/src/start.js",
    "test": "vitest run --exclude=dist/** --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:lambda:preparation": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-application-preparation-lambda.mjs",
    "build:lambda:preparation-durable": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-application-preparation-durable-lambda.mjs",
    "build:lambda:preparation-starter": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-application-preparation-starter-lambda.mjs"
  },
  "dependencies": {
    "@ai-job-apply/ai-sdk": "workspace:*",
    "@ai-job-apply/applications-service": "workspace:*",
    "@ai-job-apply/config": "workspace:*",
    "@ai-job-apply/domain": "workspace:*",
    "@ai-job-apply/documents-service": "workspace:*",
    "@ai-job-apply/event-contracts": "workspace:*",
    "@ai-job-apply/ingestion-worker": "workspace:*",
    "@ai-job-apply/jobs-service": "workspace:*",
    "@ai-job-apply/observability": "workspace:*",
    "@ai-job-apply/profile-service": "workspace:*",
    "@ai-job-apply/trust-service": "workspace:*",
    "@aws-sdk/client-kms": "3.1133.0",
    "@aws-sdk/client-lambda": "3.1133.0",
    "@aws-sdk/client-s3": "3.1133.0",
    "@aws-sdk/client-sqs": "3.1133.0",
    "@aws/durable-execution-sdk-js": "2.4.0",
    "ajv": "8.20.0",
    "pino": "10.3.1",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@aws/durable-execution-sdk-js-testing": "1.1.4",
    "@types/aws-lambda": "8.10.163",
    "tsx": "4.23.13"
  }
}
