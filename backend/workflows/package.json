{
  "name": "@ai-job-apply/workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/profile-readiness-durable.d.ts",
      "default": "./dist/src/profile-readiness-durable.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lambda": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-workflow-ingress-lambda.mjs && node ../../scripts/build-profile-readiness-lambdas.mjs && node ../../scripts/build-ingestion-lambdas.mjs",
    "build:lambda:ingestion": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-ingestion-lambdas.mjs",
    "build:lambda:ingress": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-workflow-ingress-lambda.mjs",
    "build:lambda:profile": "pnpm --filter @ai-job-apply/workflows... build && node ../../scripts/build-profile-readiness-lambdas.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/start.ts",
    "preflight:provider-source": "node --import tsx src/run-provider-source-preflight.ts",
    "replay:candidate-deletions": "tsx src/run-candidate-deletion-recovery-replay.ts",
    "start": "node dist/src/start.js",
    "test": "vitest run --exclude=dist/** --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-job-apply/config": "workspace:*",
    "@ai-job-apply/domain": "workspace:*",
    "@ai-job-apply/event-contracts": "workspace:*",
    "@ai-job-apply/ingestion-worker": "workspace:*",
    "@ai-job-apply/jobs-service": "workspace:*",
    "@ai-job-apply/observability": "workspace:*",
    "@ai-job-apply/profile-service": "workspace:*",
    "@aws-sdk/client-kms": "3.1116.0",
    "@aws-sdk/client-lambda": "3.1116.0",
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/client-sqs": "3.1116.0",
    "@aws/durable-execution-sdk-js": "2.3.0",
    "pino": "10.3.1",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@aws/durable-execution-sdk-js-testing": "1.1.3",
    "@types/aws-lambda": "8.10.162",
    "tsx": "4.23.12"
  }
}
