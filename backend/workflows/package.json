{
  "name": "@ai-job-apply/workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/workflows.d.ts",
      "default": "./dist/src/workflows.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "cloud:verify": "node cloud-conformance.mjs",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/start.ts",
    "start": "node dist/src/start.js",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-job-apply/config": "workspace:*",
    "@ai-job-apply/domain": "workspace:*",
    "@ai-job-apply/event-contracts": "workspace:*",
    "@ai-job-apply/observability": "workspace:*",
    "@ai-job-apply/profile-service": "workspace:*",
    "@temporalio/client": "1.21.1",
    "@temporalio/worker": "1.21.1",
    "@temporalio/workflow": "1.21.1",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "tsx": "4.23.1"
  }
}
