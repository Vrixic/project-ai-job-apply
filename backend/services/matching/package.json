{
  "name": "@ai-job-apply/matching-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:migrate": "node --env-file-if-exists=../../../.env dist/src/migrate.js",
    "test": "vitest run src --exclude=dist/** --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-job-apply/api-contracts": "workspace:*",
    "postgres": "3.4.9",
    "uuid": "14.0.1"
  }
}
