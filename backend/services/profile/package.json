{
  "name": "@ai-job-apply/profile-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./schema": {
      "types": "./dist/src/schema.d.ts",
      "default": "./dist/src/schema.js"
    },
    "./document-processing-acceptance": {
      "types": "./dist/src/document-processing-acceptance.d.ts",
      "default": "./dist/src/document-processing-acceptance.js"
    },
    "./candidate-rights": {
      "types": "./dist/src/candidate-rights.d.ts",
      "default": "./dist/src/candidate-rights.js"
    },
    "./ugc-contribution-consent": {
      "types": "./dist/src/ugc-contribution-consent.d.ts",
      "default": "./dist/src/ugc-contribution-consent.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:migrate": "node --env-file-if-exists=../../../.env dist/src/migrate.js",
    "test": "vitest run src --exclude=dist/** --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-job-apply/api-contracts": "workspace:*",
    "@ai-job-apply/auth": "workspace:*",
    "@ai-job-apply/domain": "workspace:*",
    "@ai-job-apply/event-contracts": "workspace:*",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "uuid": "14.0.2"
  }
}
