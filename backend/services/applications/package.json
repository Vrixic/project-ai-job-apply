{
  "name": "@ai-job-apply/applications-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./native-resume-admission": {
      "types": "./dist/src/native-resume-admission.d.ts",
      "default": "./dist/src/native-resume-admission.js"
    },
    "./native-material-runtime": {
      "types": "./dist/src/native-material-runtime.d.ts",
      "default": "./dist/src/native-material-runtime.js"
    },
    "./legacy-receipt-runtime": {
      "types": "./dist/src/legacy-receipt-runtime.d.ts",
      "default": "./dist/src/legacy-receipt-runtime.js"
    },
    "./restricted-packet-runtime": {
      "types": "./dist/src/restricted-packet-runtime.d.ts",
      "default": "./dist/src/restricted-packet-runtime.js"
    },
    "./native-resume-request-store": {
      "types": "./dist/src/native-resume-request-store.d.ts",
      "default": "./dist/src/native-resume-request-store.js"
    },
    "./native-material-withdrawal": {
      "types": "./dist/src/native-material-withdrawal.d.ts",
      "default": "./dist/src/native-material-withdrawal.js"
    },
    "./native-material-cleanup-queue": {
      "types": "./dist/src/native-material-cleanup-queue.d.ts",
      "default": "./dist/src/native-material-cleanup-queue.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:migrate": "node --env-file-if-exists=../../../.env dist/src/migrate.js",
    "test": "vitest run src --exclude=dist/** --exclude=src/**/*.integration.test.ts --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-job-apply/api-contracts": "workspace:*",
    "@ai-job-apply/domain": "workspace:*",
    "@ai-job-apply/event-contracts": "workspace:*",
    "postgres": "4.0.0",
    "uuid": "14.0.3",
    "@aws-sdk/client-kms": "3.1161.0"
  },
  "devDependencies": {
    "@ai-job-apply/profile-service": "workspace:*"
  }
}
