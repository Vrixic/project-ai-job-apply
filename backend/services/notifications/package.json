{
  "name": "@ai-job-apply/notifications-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./providers": {
      "types": "./dist/src/providers/index.d.ts",
      "default": "./dist/src/providers/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:migrate": "node --env-file-if-exists=../../../.env dist/src/migrate.js",
    "test": "vitest run src --exclude=dist/** --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "3.1133.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-sesv2": "3.1133.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sesv2": {
      "optional": true
    }
  }
}
