{
  "name": "@ai-job-apply/jobs-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./native-resume-admission": {
      "types": "./dist/src/native-resume-admission.d.ts",
      "default": "./dist/src/native-resume-admission.js"
    },
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:migrate": "node --env-file-if-exists=../../../.env dist/src/migrate.js",
    "test": "vitest run src --exclude=dist/** --exclude=src/**/*.integration.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-job-apply/api-contracts": "workspace:*",
    "@ai-job-apply/config": "workspace:*",
    "@ai-job-apply/event-contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "uuid": "14.0.2"
  }
}
