{
  "name": "@ai-job-apply/documents-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lambda": "pnpm --filter @ai-job-apply/documents-service... build && node ../../../scripts/build-document-lambdas.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:migrate": "node --env-file-if-exists=../../../.env dist/src/migrate.js",
    "test": "vitest run src --exclude=dist/** --exclude=src/**/*.integration.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-job-apply/api-contracts": "workspace:*",
    "@ai-job-apply/event-contracts": "workspace:*",
    "@ai-job-apply/profile-service": "workspace:*",
    "@aws-sdk/client-lambda": "3.1111.0",
    "@aws-sdk/client-s3": "3.1111.0",
    "@aws-sdk/client-sts": "3.1111.0",
    "@aws-sdk/s3-presigned-post": "3.1111.0",
    "@thednp/dommatrix": "3.1.1",
    "pdfjs-dist": "6.2.108",
    "postgres": "3.4.9",
    "saxes": "6.0.0",
    "uuid": "14.0.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "yazl": "3.3.1"
  }
}
