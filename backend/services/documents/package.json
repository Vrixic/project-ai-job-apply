{
  "name": "@ai-job-apply/documents-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./native-task-retirement": {
      "types": "./dist/src/native-task-retirement.d.ts",
      "default": "./dist/src/native-task-retirement.js"
    },
    "./native-read-authorization-client": {
      "types": "./dist/src/native-read-authorization-client.d.ts",
      "default": "./dist/src/native-read-authorization-client.js"
    },
    "./native-memory-transport": {
      "types": "./dist/src/native-memory-transport.d.ts",
      "default": "./dist/src/native-memory-transport.js"
    },
    "./native-memory-session": {
      "types": "./dist/src/native-memory-session.d.ts",
      "default": "./dist/src/native-memory-session.js"
    },
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./resume-tailoring": {
      "types": "./dist/src/resume-tailoring.d.ts",
      "default": "./dist/src/resume-tailoring.js"
    },
    "./cover-letter-provider": {
      "types": "./dist/src/cover-letter-provider.d.ts",
      "default": "./dist/src/cover-letter-provider.js"
    },
    "./cover-letter-runtime": {
      "types": "./dist/src/cover-letter-runtime.d.ts",
      "default": "./dist/src/cover-letter-runtime.js"
    },
    "./cover-letter-export": {
      "types": "./dist/src/cover-letter-export.d.ts",
      "default": "./dist/src/cover-letter-export.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lambda": "pnpm --filter @ai-job-apply/documents-service... build && node ../../../scripts/build-document-lambdas.mjs",
    "build:lambda:private-controls": "pnpm --filter @ai-job-apply/documents-service... build && node ../../../scripts/build-private-document-lambdas.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:migrate": "node --env-file-if-exists=../../../.env dist/src/migrate.js",
    "test": "vitest run src --exclude=dist/** --exclude=src/**/*.integration.test.ts --testTimeout=30000 --hookTimeout=30000",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:lambda:isolated-provider": "pnpm --filter @ai-job-apply/documents-service... build && node ../../../scripts/build-isolated-provider-lambda.mjs",
    "build:lambda:response-maintenance": "pnpm --filter @ai-job-apply/documents-service... build && node ../../../scripts/build-response-maintenance-lambda.mjs"
  },
  "dependencies": {
    "@ai-job-apply/ai-sdk": "workspace:*",
    "@ai-job-apply/api-contracts": "workspace:*",
    "@ai-job-apply/auth": "workspace:*",
    "@ai-job-apply/domain": "workspace:*",
    "@ai-job-apply/event-contracts": "workspace:*",
    "@ai-job-apply/profile-service": "workspace:*",
    "@aws-sdk/client-ecs": "3.1133.0",
    "@aws-sdk/client-lambda": "3.1133.0",
    "@aws-sdk/client-s3": "3.1133.0",
    "@aws-sdk/client-sts": "3.1133.0",
    "@aws-sdk/s3-presigned-post": "3.1133.0",
    "@thednp/dommatrix": "3.1.2",
    "pdfjs-dist": "6.3.289",
    "postgres": "3.4.9",
    "saxes": "6.0.0",
    "uuid": "14.0.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.163",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1"
  }
}
