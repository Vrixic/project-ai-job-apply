  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lambda": "pnpm --filter @ai-job-apply/documents-service... build && node ../../../scripts/build-document-lambdas.mjs",
    "build:lambda:private-controls": "pnpm --filter @ai-job-apply/documents-service... build && node ../../../scripts/build-private-document-lambdas.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:migrate": "node --env-file-if-exists=../../../.env dist/src/migrate.js",
    "test": "vitest run src --exclude=dist/** --exclude=src/**/*.integration.test.ts --testTimeout=30000 --hookTimeout=30000",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:lambda:isolated-provider": "pnpm --filter @ai-job-apply/documents-service... build && node ../../../scripts/build-isolated-provider-lambda.mjs",
