# Use an allowlist so ignored credentials, Terraform state, Git metadata, local caches, generated
# output, and unrelated workstation files can never enter a container build context.
**

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!turbo.json
!tsconfig.base.json

# The frozen workspace install applies this exact reviewed dependency patch.
!patches/
!patches/image-size@1.2.1.patch

!backend/
!backend/**
!frontend/
!frontend/**
!packages/
!packages/**

# Re-exclude generated, dependency, cache, and environment files below allowlisted source trees.
**/node_modules/
**/dist/
**/.next/
**/.turbo/
**/coverage/
**/.env
**/.env.*
