FROM node:24.12.0-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm contracts:generate && pnpm --filter @ai-job-apply/web... build

FROM node:24.12.0-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /workspace/frontend/web/.next/standalone ./
COPY --from=build /workspace/frontend/web/.next/static ./frontend/web/.next/static
USER node
EXPOSE 3000
CMD ["node", "frontend/web/server.js"]
