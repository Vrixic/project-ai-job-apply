{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "D2_EXTENSION_BROWSER",
    "D2_EXTENSION_BROWSER_NAME",
    "D2_EXTENSION_CHROME_FOR_TESTING",
    "D2_EXTENSION_EDGE_BROWSER",
    "LOCALAPPDATA",
    "PLAYWRIGHT_BROWSERS_PATH",
    "ProgramFiles",
    "ProgramFiles(x86)"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "D2_CANCELLATION_DATABASE_URL",
        "D2_COMPOSED_DATABASE_URL"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
