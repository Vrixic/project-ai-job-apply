{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "D2_EXTENSION_BROWSER",
    "D2_EXTENSION_BROWSER_NAME",
    "D2_EXTENSION_CHROME_FOR_TESTING",
    "D2_EXTENSION_EDGE_BROWSER",
    "LOCALAPPDATA",
    "PLAYWRIGHT_BROWSERS_PATH",
    "ProgramFiles",
    "ProgramFiles(x86)"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@ai-job-apply/database-migrations#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/backend/services/applications/migrations/**",
        "$TURBO_ROOT$/backend/services/billing/migrations/**",
        "$TURBO_ROOT$/backend/services/documents/migrations/**",
        "$TURBO_ROOT$/backend/services/jobs/migrations/**",
        "$TURBO_ROOT$/backend/services/matching/migrations/**",
        "$TURBO_ROOT$/backend/services/profile/migrations/**",
        "$TURBO_ROOT$/backend/services/trust/migrations/**"
      ],
      "outputs": []
    },
    "@ai-job-apply/workflows#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/backend/services/database-migrations/restore-manifest.v1.json",
        "$TURBO_ROOT$/scripts/tests/fixtures/candidate-deletion-restore-contract.v1.json"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "D2_CANCELLATION_DATABASE_URL",
        "D2_COMPOSED_DATABASE_URL",
        "NATIVE_MATERIAL_LAUNCH_INTEGRATION",
        "NATIVE_MATERIAL_LAUNCH_TEST_DATABASE_URL"
      ],
      "outputs": []
    },
    "@ai-job-apply/applications-service#test:integration": {
      "dependsOn": ["build", "^build", "@ai-job-apply/profile-service#build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"],
      "outputs": []
    },
    "@ai-job-apply/jobs-service#test:integration": {
      "dependsOn": ["build", "^build", "@ai-job-apply/ingestion-worker#build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "D2_CANCELLATION_DATABASE_URL",
        "D2_COMPOSED_DATABASE_URL"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
