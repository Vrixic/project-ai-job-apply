{
  "name": "ai-job-apply",
  "version": "0.1.0",
  "private": true,
  "description": "Candidate-first job discovery and application platform monorepo",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-fastify@11.1.28>find-my-way": "9.7.0",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "minimatch@10.2.6>brace-expansion": "5.0.9",
      "minimatch@5.1.9>brace-expansion": "5.0.9",
      "next@16.2.12>postcss": "8.5.24",
      "next@16.2.12>sharp": "0.35.0",
      "xcode@3.0.1>uuid": "11.1.1"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "auth0:verify": "node scripts/verify-auth0-tenant.mjs",
    "check": "pnpm skills:validate && pnpm infrastructure:validate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo run clean",
    "contracts:generate": "pnpm --filter @ai-job-apply/api-contracts generate",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "infrastructure:validate": "node scripts/validate-serverless-workflow-infrastructure.mjs",
    "lint": "biome lint .",
    "skills:validate": "node scripts/validate-skills.mjs",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "yazl": "3.3.1"
  }
}
