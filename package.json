{
  "name": "ai-job-apply",
  "version": "0.1.0",
  "private": true,
  "description": "Candidate-first job discovery and application platform monorepo",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "auth0:verify": "node scripts/verify-auth0-tenant.mjs",
    "check": "pnpm skills:validate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo run clean",
    "contracts:generate": "pnpm --filter @ai-job-apply/api-contracts generate",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "skills:validate": "node scripts/validate-skills.mjs",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "24.10.1",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "vitest": "4.0.14"
  }
}
